# Copy this file to .env next to docker-compose.yml and fill in the API key.
#
#   cp .env.example .env
#   docker compose up -d
#
# .env is gitignored; this example is not, so keep secrets out of it.

# --- required ---------------------------------------------------------------

# Immich API key: Immich web UI -> Account Settings -> API Keys.
# Compose refuses to start when this is empty, which is better than booting with
# no key and having every Immich request come back 401.
IMMICH_API_KEY=

# --- optional, shown with their defaults ------------------------------------

# Host port for the settings page, and the port the frame connects to. It has to
# match the server URL saved in the frame's captive portal.
EPF_PORT=15001

# Local timezone. The base image has none, so leaving this unset makes
# datetime.now() return UTC: /sleep would then evaluate the quiet hours and the
# wake-up schedule in UTC and they would land at the wrong time of day.
TZ=Asia/Taipei

# --- low battery notifications ----------------------------------------------
#
# Nothing to set here. Telegram and LINE are linked from the settings page, which
# stores the credentials in /config/credentials.json so they can be changed
# without recreating the container. A service only counts as linked once a test
# message has actually been delivered.
