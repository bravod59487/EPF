# Copy this file to .env next to docker-compose.yml and fill in the API key.
#
#   cp .env.example .env
#   docker compose up -d
#
# .env is gitignored; this example is not, so keep secrets out of it.

# --- required ---------------------------------------------------------------

# Immich API key: Immich web UI -> Account Settings -> API Keys.
# Compose refuses to start when this is empty, which is better than booting with
# no key and having every Immich request come back 401.
IMMICH_API_KEY=

# --- optional, shown with their defaults ------------------------------------

# Host port for the settings page, and the port the frame connects to. It has to
# match the server URL saved in the frame's captive portal.
EPF_PORT=15001

# Local timezone. The base image has none, so leaving this unset makes
# datetime.now() return UTC: /sleep would then evaluate the quiet hours and the
# wake-up schedule in UTC and they would land at the wrong time of day.
TZ=Asia/Taipei

# --- low battery notifications, if you want them ----------------------------
#
# Credentials live here rather than in config.yaml because the settings page has
# no authentication: anything stored in the config is readable by anyone who can
# open the page. Whether warnings are on, the battery level and how often are all
# set on the settings page. Use the "send a test" button to check these work.
#
# Telegram: message @BotFather to create a bot and get the token, then send your
# bot a message and read the chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# LINE needs the Messaging API: create a channel in the LINE Developers console,
# take its channel access token, and use your own userId as the destination.
# LINE Notify, which needed only one token, was discontinued in 2025.
LINE_CHANNEL_TOKEN=
LINE_USER_ID=
